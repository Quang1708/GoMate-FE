# Copy to .env.local. Expo embeds EXPO_PUBLIC_ variables; never put secrets here.
# Expo web on localhost. For Android emulator use http://10.0.2.2:3000/api.
# On a physical device use the computer's LAN IP and set BE HOST=0.0.0.0.
# For web served by BE after export, use /api.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
