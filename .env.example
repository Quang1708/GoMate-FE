# Copy to .env.local. Expo embeds EXPO_PUBLIC_ variables; never put secrets here.
# Leave empty in development to use the browser/Expo host on API port 3000.
# On a physical device set BE HOST=0.0.0.0 and use the same LAN as the computer.
# Override for a remote API, nonstandard port, or Expo tunnel (API needs its own URL).
# For web served by BE after export, use /api.
EXPO_PUBLIC_API_BASE_URL=

# Optional: keep disabled until Google provider setup is supplied.
# Web reads GOOGLE_CLIENT_ID from BE /auth/google/config.
EXPO_PUBLIC_GOOGLE_NATIVE_ENABLED=false
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Mapbox and VIETMAP are configured on BE, not via EXPO_PUBLIC_ keys.
# See docs/MAPBOX_SETUP.md and GoMate-BE/.env.example.
